{
  "mcpServers": {
    "angular-cli": {
      "type": "stdio",
      "command": "node",
      "args": ["node_modules/@angular/cli/bin/ng.js", "mcp"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chromium",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
